 import { homedir } from "node:os";
@@ -30,7 +31,16 @@ export type AccountSummary = {
   lastUsedAt: number;
 };
 
+const accountDirectories = new AsyncLocalStorage<string>();
+
+/** Isolate account lookups per embedding runtime without mutating process.env. */
+export function withAntigravityAccountDirectory<T>(directory: string, action: () => T): T {
+  return accountDirectories.run(directory, action);
+}
+
 function agentDir(): string {
+  const directory = accountDirectories.getStore();
+  if (directory) return directory;
   return process.env.PI_CODING_AGENT_DIR || join(homedir(), ".pi", "agent");
 }
 
