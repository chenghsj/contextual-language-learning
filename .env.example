# Desktop OAuth Client ID (public application identifier, not a client secret).
# Embedded into the Native Host during build. End users do not need an .env file.
GOOGLE_OAUTH_CLIENT_ID=123456789-example.apps.googleusercontent.com

# Optional: only if Google's token endpoint requires the Desktop client secret.
# Installed desktop credentials are extractable from the Native Host bundle;
# do not treat this value as a confidential server-side secret.
# GOOGLE_OAUTH_CLIENT_SECRET=your-desktop-client-secret

# Web OAuth client in the same Google Cloud project; public client ID only.
VITE_GOOGLE_WEB_CLIENT_ID=
