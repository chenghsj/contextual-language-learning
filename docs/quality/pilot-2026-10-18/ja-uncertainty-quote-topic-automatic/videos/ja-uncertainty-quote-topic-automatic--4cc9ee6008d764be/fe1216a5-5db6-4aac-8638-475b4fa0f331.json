  "points": [
    {
      "id": "0601b4ad-aa7d-4a56-a85d-062b2f3f2755:s0:p1",
      "utteranceIds": [
        "7e7f2813-ea7f-460a-907f-703902810af4"
      ],
      "category": "grammar",
      "presentation": "core",
      "title": "動詞「〜てた」口語過去進行與狀態縮約",
      "sourceCueIds": [
        "c1"
      ],
      "contextCueIds": [
        "c1"
      ],
      "explanation": "「話してた」是動詞「話していた」（話す＋ていた）的口語縮約形式，省略了中間的「い」。在對話中常以疑問句「〜てた？」詢問對方或第三方「剛才有在做某事嗎？」。",
      "sourceSpans": [
        {
          "cueId": "c1",
          "start": 9,
          "end": 14
        }
      ]
    },
    {
      "id": "0601b4ad-aa7d-4a56-a85d-062b2f3f2755:s0:p2",
      "utteranceIds": [
        "855ee9f0-5d7a-48ce-9127-740f12c0deeb"
      ],
      "category": "grammar",
      "presentation": "core",
      "title": "口語引用助詞「〜って」句尾轉述",
      "sourceCueIds": [
        "c2"
      ],
      "contextCueIds": [
        "c1",
        "c2"
      ],
      "explanation": "「って」在口語中相當於引用助詞「と」，句尾單獨使用時相當於「〜と言っていた／と言っている」，用來轉述第三者所說的話，省略了後續的述語動詞。",
      "sourceSpans": [
        {
          "cueId": "c2",
          "start": 9,
          "end": 11
        }
      ]
    },
    {
      "id": "0601b4ad-aa7d-4a56-a85d-062b2f3f2755:s0:p3",
      "utteranceIds": [
        "8a57824d-725c-47b5-aa54-d25432a8594a"
      ],
      "category": "usage",
      "presentation": "core",
      "title": "轉換對話焦點的接續詞「ところで」",
      "sourceCueIds": [
        "c2"
      ],
      "contextCueIds": [
        "c2"
      ],
      "explanation": "用於結束前一個話題，自然切換至新的、通常無直接關聯的主題，相當於中文的「話說回來」、「順便問一下」。",
      "sourceSpans": [
        {
          "cueId": "c2",
          "start": 11,
          "end": 15
        }
      ]
    },
    {
      "id": "0601b4ad-aa7d-4a56-a85d-062b2f3f2755:s0:p4",
      "utteranceIds": [
        "5f53217c-f82d-4f38-9b1b-c77ce9425b02"
      ],
      "category": "grammar",
      "presentation": "core",
      "title": "詢問詞義與概念的句型「〜って何？」",
      "sourceCueIds": [
        "c3"
      ],
      "contextCueIds": [
        "c3"
      ],
      "explanation": "助詞「って」在此作主題提示（相當於「というのは」或「とは」的口語形），接在單詞或短語後，搭配疑問詞「何」組成「〜って何？」，意思是「……是什麼意思？」或「……是什麼東西？」。",
      "sourceSpans": [
        {
          "cueId": "c3",
          "start": 14,
          "end": 18
        }
      ]
    },
    {
      "id": "0601b4ad-aa7d-4a56-a85d-062b2f3f2755:s0:p5",
      "utteranceIds": [
        "42488205-118c-4d2b-9500-8418a0db35d0"
      ],
      "category": "vocabulary",
      "presentation": "core",
      "title": "「よく＋否定」表示不太了解或不甚清楚",
      "sourceCueIds": [
        "c4"
      ],
      "contextCueIds": [
        "c4"
      ],
      "explanation": "副詞「よく」單獨使用通常表「充分、清楚」，但與否定謂語「わからない」搭配時，表達「不太清楚、看不太懂」，是一種委婉或程度上的部分否定。",
      "sourceSpans": [
        {
          "cueId": "c4",
          "start": 3,
          "end": 10
        }
      ]
    }
  ],
