        "id": "c1",
        "startMs": 0,
        "endMs": 2800,
        "originalText": "Maya ha parlato della riunione?"
      },
      {
        "id": "c2",
        "startMs": 3000,
        "endMs": 5800,
        "originalText": "“Dimmi l’ora”, ha detto. A proposito, hai già mangiato?"
      },
      {
        "id": "c3",
        "startMs": 6000,
        "endMs": 8800,
        "originalText": "Non ancora. Che cosa significa [???] qui?"
      },
      {
        "id": "c4",
        "startMs": 9000,
        "endMs": 11800,
        "originalText": "Il sottotitolo non è chiaro."
      }
    ]
  },
