      "utteranceIds": [
        "56d4d028-a4a3-450c-bfb0-a68af2b61cac"
      ],
      "category": "grammar",
      "presentation": "core",
      "title": "〜ちゃって（〜てしまって）：不由自主、不知不覺就……",
      "sourceCueIds": [
        "c2"
      ],
      "contextCueIds": [
        "c1"
      ],
      "explanation": "為「〜てしまって」在口語中的常見縮約形（「〜てしまう」縮略為「〜ちゃう」）。此處接在動詞連用形「描きたく（想畫）」後面，表示隨著靈感湧現，不由自主地產生強烈創作慾望的心情。",
      "sourceSpans": [
        {
          "cueId": "c2",
          "start": 28,
          "end": 32
        }
      ]
    },
    {
      "id": "5d11643c-e77a-4c38-92b0-f4fa2037ed4b:s0:p3",
      "utteranceIds": [
        "06484bf0-ba3c-454b-908e-6d7cf6159653"
      ],
      "category": "chunks",
      "presentation": "core",
      "title": "〜が気になる：在乎、感興趣、放不下心",
      "sourceCueIds": [
        "c3"
      ],
      "contextCueIds": [
        "c2"
      ],
      "explanation": "表示某事物引起了自己的注意力，使人在意、好奇或感興趣。此處表示對方所畫的那部漫畫引起了說話者的好奇心，讓人想要多加了解。",
      "sourceSpans": [
        {
          "cueId": "c3",
          "start": 8,
          "end": 17
        }
      ]
    },
    {
      "id": "5d11643c-e77a-4c38-92b0-f4fa2037ed4b:s0:p4",
      "utteranceIds": [
        "d4069618-5a1b-4eb4-8df2-bc62238843d7"
      ],
      "category": "grammar",
      "presentation": "core",
      "title": "〜てれば／〜でれば（〜ていれば）：只要一直處於某動作或狀態",
      "sourceCueIds": [
        "c4"
      ],
      "contextCueIds": [
        "c3"
      ],
      "explanation": "為「[動詞て形]いれば」在口語中省略「い」的縮約形式。動詞「読む」的て形為「読んで」，加上「いれば」後口語縮約為「読んでれば」。在此表示「只要抽空持續讀下去」的假定條件。",
      "sourceSpans": [
        {
          "cueId": "c4",
          "start": 8,
          "end": 13
        }
      ]
    }
