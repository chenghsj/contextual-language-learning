                ],
                "category": "grammar",
                "presentation": "core",
                "title": "引用助詞「って」：口語轉述他人話語",
                "sourceCueIds": [
                  "c2"
                ],
                "contextCueIds": [
                  "c1"
                ],
                "explanation": "在句尾直接使用引用助詞「って」，相當於「〜と言っていた」或「〜と言って」，用來簡潔轉述他人剛才說過的話或要求。此處承接上一句對談話內容的詢問，直接引用對方的發言。",
                "sourceSpans": [
                  {
                    "cueId": "c2",
                    "start": 9,
                    "end": 11
                  }
                ]
              },
              {
