        "startMs": 0,
        "endMs": 2800,
        "originalText": "Maya có nói về cuộc họp không?"
      },
      {
        "id": "c2",
        "startMs": 3000,
        "endMs": 5800,
        "originalText": "“Cho tôi biết giờ nhé”, cô ấy nói. À, bạn ăn chưa?"
      },
      {
        "id": "c3",
        "startMs": 6000,
        "endMs": 8800,
        "originalText": "Chưa. [???] ở đây nghĩa là gì?"
      },
      {
        "id": "c4",
        "startMs": 9000,
        "endMs": 11800,
        "originalText": "Phụ đề không rõ."
      }
    ]
