                "c3",
                "c4"
              ]
            },
            "translations": [
              {
                "cueId": "c1",
                "text": "Maya 有談到那次會面嗎？"
              },
              {
                "cueId": "c2",
                "text": "「請告知時間，」對方說道。對了，吃過了嗎？"
              },
              {
                "cueId": "c3",
                "text": "還沒。這裡標記為「[???]」之未明內容是什麼意思？"
              },
              {
                "cueId": "c4",
                "text": "那個字幕不清楚。"
              }
            ],
