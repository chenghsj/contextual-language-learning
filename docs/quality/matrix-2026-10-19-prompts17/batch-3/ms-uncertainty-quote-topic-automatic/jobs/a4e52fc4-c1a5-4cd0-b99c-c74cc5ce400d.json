    "cues": [
      {
        "id": "c1",
        "startMs": 0,
        "endMs": 2800,
        "originalText": "Maya bercakap tentang perjumpaan itu?"
      },
      {
        "id": "c2",
        "startMs": 3000,
        "endMs": 5800,
        "originalText": "“Tolong beritahu waktunya,” katanya. Oh ya, sudah makan?"
      },
      {
        "id": "c3",
        "startMs": 6000,
        "endMs": 8800,
        "originalText": "Belum. Apa maksud [???] di sini?"
      },
      {
        "id": "c4",
        "startMs": 9000,
        "endMs": 11800,
        "originalText": "Sari kata itu tidak jelas."
      }
    ]
  },
