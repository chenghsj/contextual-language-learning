      "category": "grammar",
      "presentation": "core",
      "title": "未完成過去時搭配不定式表示過去正打算做某事",
      "sourceCueIds": [
        "c2"
      ],
      "contextCueIds": [],
      "explanation": "「aller 的未完成過去時（allais/allait 等）＋動詞不定式」用來表達過去某個時間點「正打算做……」或「剛要去做……」。在句中常與 quand 引導的複合過去時（passé composé）子句連用，表示某個突發動作發生時，另一項動作原本正準備進行。",
      "sourceSpans": [
        {
          "cueId": "c2",
          "start": 0,
          "end": 15
        }
      ]
    },
    {
      "id": "91aa40ac-e1cd-409b-83a1-6b63ea9fd416:s0:p2",
      "utteranceIds": [
        "9571fe68-3e95-4db1-bd58-f709526fbec6"
      ],
      "category": "chunks",
      "presentation": "core",
      "title": "「encore là」表示仍然留在原地",
      "sourceCueIds": [
        "c1"
      ],
      "contextCueIds": [],
      "explanation": "encore 表示「仍然、還」，là 表示「這裡／在那裡」。「encore là」是日常法語中極常見的固定片語，用來指某人或某物尚未離開、仍然留在現場。",
      "sourceSpans": [
        {
          "cueId": "c1",
          "start": 15,
          "end": 24
        }
      ]
    },
    {
      "id": "91aa40ac-e1cd-409b-83a1-6b63ea9fd416:s0:p3",
      "utteranceIds": [
        "58d06770-59d5-43e8-ba57-a776e98ca32c"
      ],
      "category": "chunks",
      "presentation": "core",
      "title": "「un instant」作時間狀語表示片刻或稍候",
      "sourceCueIds": [
        "c3"
      ],
      "contextCueIds": [],
      "explanation": "un instant 字面意為「一個瞬間」，在口語與書面語中常作時間副詞片語，相當於「一會兒、片刻」。常與 attendre 等動詞搭配，提出禮貌的等待請求。",
      "sourceSpans": [
        {
          "cueId": "c3",
          "start": 17,
          "end": 27
        }
      ]
    }
