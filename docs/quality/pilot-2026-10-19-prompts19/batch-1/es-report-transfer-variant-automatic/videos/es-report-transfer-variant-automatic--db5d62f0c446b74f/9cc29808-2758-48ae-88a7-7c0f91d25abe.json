  "points": [
    {
      "id": "ee0a9883-e3c3-451d-9739-5790d842f5b1:s0:p1",
      "utteranceIds": [
        "3fefd42a-896a-4f0a-92bd-1f0e0b791d37"
      ],
      "category": "pronunciation",
      "presentation": "core",
      "title": "命令式接附著代詞的重音與拼寫（dime）",
      "sourceCueIds": [
        "c2"
      ],
      "contextCueIds": [],
      "explanation": "肯定命令式單音節動詞 di（decir 對 tú 的形式）後接間接受詞代詞 me，書寫上合為 dime。其重音仍保持在 di 上（/ˈdi.me/），屬於倒數第二音節重音（llana / paroxítona）且以母音結尾的詞，符合正字法一般重音規則，因此不加書寫重音符號（tilde）。",
      "sourceSpans": [
        {
          "cueId": "c2",
          "start": 1,
          "end": 5
        }
      ]
    },
    {
      "id": "ee0a9883-e3c3-451d-9739-5790d842f5b1:s0:p2",
      "utteranceIds": [
        "d2dd4b43-be06-4e0f-a0dd-1e5ef9cef1b2"
      ],
      "category": "chunks",
      "presentation": "core",
      "title": "Por cierto 用於話題轉換",
      "sourceCueIds": [
        "c2"
      ],
      "contextCueIds": [],
      "explanation": "Por cierto 為會話常用轉折片語，用於在對話中切換話題或順帶提及突發想到的事項，相當於「順便一提」、「對了」。",
      "sourceSpans": [
        {
          "cueId": "c2",
          "start": 28,
          "end": 38
        }
      ]
    },
    {
      "id": "ee0a9883-e3c3-451d-9739-5790d842f5b1:s0:p3",
      "utteranceIds": [
        "6da3e468-7640-4a49-8d7a-eac5f4c05af3"
      ],
      "category": "chunks",
      "presentation": "core",
      "title": "Todavía no 的簡短回應用法",
      "sourceCueIds": [
        "c3"
      ],
      "contextCueIds": [
        "c2"
      ],
      "explanation": "Todavía no 常用於簡短回應含有 ya（已經）的完成狀態問句，表示某事「尚未發生」或「還沒完成」。",
      "sourceSpans": [
        {
          "cueId": "c3",
          "start": 0,
          "end": 10
        }
      ]
    },
    {
      "id": "ee0a9883-e3c3-451d-9739-5790d842f5b1:s0:p4",
      "utteranceIds": [
        "c776031a-0d90-4be2-aefd-de79e2511f90"
      ],
      "category": "grammar",
      "presentation": "core",
      "title": "no se entiende 與被動反映 se",
      "sourceCueIds": [
        "c4"
      ],
      "contextCueIds": [],
      "explanation": "動詞 entender 搭配代詞 se 構成被動反映結構（pasiva refleja），以第三人稱單數形式表達「某事無法被理解或辨認」，主詞為被理解的客體（此處為 la última palabra），省去具體的施事者。",
      "sourceSpans": [
        {
          "cueId": "c4",
          "start": 18,
          "end": 32
        }
      ]
    }
