      ],
      "category": "grammar",
      "presentation": "core",
      "title": "口語引用詢問「って何」",
      "sourceCueIds": [
        "c3"
      ],
      "contextCueIds": [
        "c3"
      ],
      "explanation": "「って何」由口語引用助詞「って」（相當於「というのは」）與疑問詞「何」組成，接在名詞或引述內容後方，表示「……是什麼意思？」或「所謂的……是什麼？」。",
      "sourceSpans": [
        {
          "cueId": "c3",
          "start": 14,
          "end": 17
        }
      ]
    }
