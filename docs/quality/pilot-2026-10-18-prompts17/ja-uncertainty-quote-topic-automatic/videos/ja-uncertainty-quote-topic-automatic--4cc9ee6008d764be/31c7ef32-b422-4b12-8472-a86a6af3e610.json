      ],
      "category": "usage",
      "presentation": "core",
      "title": "轉換話題的「ところで」",
      "sourceCueIds": [
        "c2"
      ],
      "contextCueIds": [
        "c2"
      ],
      "explanation": "「ところで」為接續詞，意思是「話說回來」、「順便一提」，用於中斷或結束原本的話題，並自然轉換到另一個新的話題或詢問。",
      "sourceSpans": [
        {
          "cueId": "c2",
          "start": 11,
          "end": 15
        }
      ]
    },
    {
